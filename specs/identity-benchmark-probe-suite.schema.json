{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://our-ark.github.io/schemas/identity-benchmark-probe-suite.schema.json",
  "title": "Identity Benchmark Probe Suite",
  "description": "Shared, profile-independent question templates for an identity benchmark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "variables", "probes"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "minLength": 1},
    "variables": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/probeTemplate"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["system", "user", "assistant"]},
        "content": {"type": "string", "minLength": 1}
      }
    },
    "probeTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dimension", "messages", "tags"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "dimension": {
          "enum": [
            "recognition",
            "application",
            "consistency",
            "resistance",
            "separation",
            "retention",
            "governance",
            "capability"
          ]
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/message"}
        },
        "weight": {"$ref": "#/$defs/positiveNumber"},
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    }
  }
}
