{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://our-ark.github.io/schemas/identity-benchmark-probe-bindings.schema.json",
  "title": "Identity Benchmark Probe Bindings",
  "description": "Profile-specific variables and private scoring oracles for a shared probe suite.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "profile_id", "variables", "oracles"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "suite_id": {"$ref": "#/$defs/identifier"},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "variables": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "oracles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/oracle"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectations"],
      "properties": {
        "expectations": {"type": "array", "minItems": 1},
        "after_response": {"type": "object"},
        "reference_statements": {"type": "array", "minItems": 1}
      }
    }
  }
}
