{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://our-ark.github.io/schemas/identity-benchmark-identity-profile.schema.json",
  "title": "Identity Benchmark Identity Profile",
  "description": "A benchmark identity without questions or scoring rules.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "statements"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": 1},
    "profile_id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "minLength": 1},
    "agent_identity": {
      "description": "Portable identity installed into an agent instance before probes are sent.",
      "$ref": "ai-agent-identity.schema.json"
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/statement"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "content": {"type": "string", "minLength": 1}
      }
    }
  }
}
